rules_version = '2';

// Règles de sécurité de la base AMANE.
// À coller dans Firebase → Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'amane.services.securite@gmail.com';
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() { return isOwner() || (hasProfile() && profile().role == 'admin'); }
    function isGuard() { return hasProfile() && profile().role in ['guard', 'admin']; }
    function isClient() { return hasProfile() && profile().role == 'client'; }
    // Le client ne voit que les données de son propre site.
    function mySite(data) { return isClient() && data.siteId == profile().siteId; }

    // Comptes : chacun voit le sien, l'administration voit et gère tout.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'pending'
            || (isOwner() && request.resource.data.role == 'admin'));
      // Un agent ne peut changer ni son rôle ni son site.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('siteId', null) == resource.data.get('siteId', null));
      allow delete: if isAdmin();
    }

    // Sites : lus par les agents, gérés par l'administration.
    match /sites/{id} {
      allow read: if isGuard() || (isClient() && id == profile().siteId);
      allow write: if isAdmin();
    }

    // Pointages : chaque agent écrit et lit les siens.
    match /punches/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data);
      allow create: if isGuard() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isGuard() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Planning : chaque agent voit ses missions, l'administration les gère.
    match /shifts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data);
      allow write: if isAdmin();
    }

    // Main courante : l'agent écrit, l'administration lit tout.
    match /logs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data);
      allow create: if isGuard() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Taux (salaires, tarifs) : réservés à l'administration.
    match /rates/{id} {
      allow read, write: if isAdmin();
    }

    // Factures envoyées au client : lecture par le client du site concerné.
    match /invoices/{id} {
      allow read: if isAdmin() || mySite(resource.data);
      allow write: if isAdmin();
    }

    // Alertes SOS : tout compte connecté peut en envoyer, l'administration les traite.
    match /alerts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    // Messagerie client ↔ AMANE : un fil par client.
    match /messages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isAdmin()
        || (isClient() && request.resource.data.clientUid == request.auth.uid
            && request.resource.data.from == 'client');
      // Le client peut seulement marquer les réponses comme lues.
      allow update: if isAdmin()
        || (signedIn() && resource.data.clientUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenClient']));
      allow delete: if isAdmin();
    }
  }
}
