rules_version = '2';

// Règles de sécurité de la base AMANE.
// À coller dans Firebase → Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'amane.services.securite@gmail.com';
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Comptable (poste « accountant ») : uniquement la comptabilité.
    function isAccountant() {
      return !isOwner() && hasProfile() && profile().role == 'admin' && profile().get('job', '') == 'accountant';
    }
    // Opérations (Directeur et salle de contrôle) : tout sauf la comptabilité.
    function isAdmin() {
      return isOwner() || (hasProfile() && profile().role == 'admin' && profile().get('job', '') != 'accountant');
    }
    // Directeur : tout. Le responsable de la salle de contrôle (poste « operator »)
    // voit tout sauf la comptabilité et ne gère ni le personnel ni les sites.
    function isDirector() {
      return isOwner() || (hasProfile() && profile().role == 'admin'
        && !(profile().get('job', '') in ['operator', 'accountant']));
    }
    // Comptabilité : Directeur et comptable.
    function isFinance() { return isDirector() || isAccountant(); }
    function isGuard() { return hasProfile() && profile().role in ['guard', 'admin']; }
    function isClient() { return hasProfile() && profile().role == 'client'; }
    // Superviseur : voit les sites, qui y travaille, la main courante et les SOS.
    // Jamais la paie, les tarifs, les factures ni les messages clients.
    function isSupervisor() {
      return hasProfile() && profile().role == 'guard' && profile().get('job', '') == 'supervisor';
    }
    // Agents itinérants : ils doivent connaître les sites pour le pointage automatique.
    function isMobile() {
      return isGuard() && profile().get('job', '') in ['mobile', 'supervisor', 'bodyguard', 'driver'];
    }
    // Le client ne voit que les données de son propre site.
    function mySite(data) { return isClient() && data.siteId == profile().siteId; }
    // Agent affecté au même site que l'entrée (collègues du poste).
    function sameSiteGuard(data) {
      return isGuard() && profile().get('siteId', null) != null
        && data.siteId == profile().siteId;
    }

    // Comptes : chacun voit le sien, le Directeur voit et gère tout.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isAccountant()
        || (isSupervisor() && resource.data.role == 'guard'));
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'pending'
            || (isOwner() && request.resource.data.role == 'admin'));
      // Un employé ne peut changer ni son rôle, ni son site, ni son poste.
      allow update: if isDirector()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('siteId', null) == resource.data.get('siteId', null)
            && request.resource.data.get('job', null) == resource.data.get('job', null));
      allow delete: if isDirector();
    }

    // Sites : l'agent ne voit que le sien ; superviseurs et agents itinérants
    // voient tous les sites ; gérés par le Directeur.
    match /sites/{id} {
      allow read: if isAdmin() || isAccountant() || isMobile()
        || (isGuard() && id == profile().get('siteId', ''))
        || (isClient() && id == profile().siteId);
      allow write: if isDirector();
    }

    // Pointages : chaque agent écrit et lit les siens.
    match /punches/{id} {
      allow read: if isAdmin() || isAccountant() || isSupervisor() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data);
      allow create: if isGuard() && request.resource.data.uid == request.auth.uid;
      // L'agent ne peut que pointer son départ (une seule fois) et envoyer sa
      // position pendant le service : jamais modifier l'heure d'arrivée ou le site.
      allow update: if isDirector()
        || (isGuard() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['outAt', 'outLat', 'outLng', 'outAcc', 'outDist', 'outOk',
                           'lastLat', 'lastLng', 'lastAcc', 'lastAt'])
            && !('outAt' in resource.data));
      allow delete: if isDirector();
    }

    // Planning : chaque agent voit ses missions, l'administration les gère.
    match /shifts/{id} {
      allow read: if isAdmin() || isSupervisor() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data);
      allow write: if isAdmin();
    }

    // Main courante : confidentielle. Lecture réservée à l'administration,
    // au client du site et aux agents affectés à ce même site.
    match /logs/{id} {
      allow read: if isAdmin() || isSupervisor() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data) || sameSiteGuard(resource.data);
      // L'agent n'écrit que dans la main courante de son propre site.
      allow create: if isGuard() && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('siteId', null) == profile().get('siteId', null);
      allow update, delete: if isDirector();
    }

    // Photos de la main courante (preuves) : image JPEG compressée en base64.
    match /photos/{id} {
      allow read: if isAdmin() || isSupervisor() || (signedIn() && resource.data.uid == request.auth.uid)
        || mySite(resource.data) || sameSiteGuard(resource.data);
      allow create: if isGuard() && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('siteId', null) == profile().get('siteId', null)
        && request.resource.data.data is string && request.resource.data.data.size() < 950000;
      allow update, delete: if isDirector();
    }

    // Consignes de site : proposées par le client, validées par AMANE,
    // visibles par le client du site et, une fois validées, par ses agents.
    match /instructions/{id} {
      allow read: if isAdmin() || mySite(resource.data)
        || ((sameSiteGuard(resource.data) || isSupervisor()) && resource.data.status == 'approved');
      allow create: if isAdmin()
        || (isClient() && request.resource.data.siteId == profile().siteId
            && request.resource.data.status == 'pending'
            && request.resource.data.from == 'client'
            && request.resource.data.by == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Fiches de paie publiées : l'administration et l'employé concerné seulement.
    match /payslips/{id} {
      allow read: if isFinance() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isFinance();
    }

    // Taux (salaires, tarifs, dépenses) : Directeur et comptable.
    match /rates/{id} {
      allow read, write: if isFinance();
    }

    // Factures envoyées au client : lecture par le client du site concerné.
    match /invoices/{id} {
      allow read: if isFinance() || mySite(resource.data);
      allow write: if isFinance();
    }

    // Alertes SOS : employés et clients actifs (pas les comptes en attente ou
    // désactivés) ; l'administration les traite.
    match /alerts/{id} {
      allow read: if isAdmin() || isSupervisor() || (signedIn() && resource.data.uid == request.auth.uid);
      // La salle de contrôle crée aussi les alertes automatiques (trajet en retard).
      allow create: if (isAdmin() && request.resource.data.source == 'auto')
        || (isGuard() || isClient()) && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      // L'auteur peut seulement ajouter sa position si le GPS a répondu en retard.
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['Lat', 'Lng', 'Acc', 'lateFix', 'gpsErr']));
      allow delete: if isAdmin();
    }

    // Trajets des clients (« Je suis en route ») : suivis par la salle de
    // contrôle ; le client ne met à jour que sa position et la fin du trajet.
    match /trips/{id} {
      allow read: if isAdmin() || isSupervisor() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isClient() && request.resource.data.uid == request.auth.uid
        && request.resource.data.active == true;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastLat', 'lastLng', 'lastAcc', 'lastAt', 'lastOk', 'active', 'endAt']));
      allow delete: if isAdmin();

      // Parcours du trajet (points envoyés par le voyageur, même en différé).
      match /points/{p} {
        allow read: if isAdmin() || isSupervisor()
          || (signedIn() && get(/databases/$(database)/documents/trips/$(id)).data.uid == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/trips/$(id)).data.uid == request.auth.uid;
      }
    }

    // Messagerie client ↔ AMANE : un fil par client.
    match /messages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isAdmin()
        || (isClient() && request.resource.data.clientUid == request.auth.uid
            && request.resource.data.from == 'client');
      // Le client peut seulement marquer les réponses comme lues.
      allow update: if isAdmin()
        || (signedIn() && resource.data.clientUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenClient']));
      allow delete: if isAdmin();
    }
  }
}
